        "id": "f3eb1658b28db502",
        "type": "function",
        "z": "0feaaf0c3923705a",
        "g": "5143a28f03cf2d9c",
        "name": "Volladung Logic",
        "func": "// =====================\n// Volladung Logic (Victron)\n// Output 1: DVCC Spannung\n// Output 2: History schreiben (nur bei Volladung)\n// =====================\n\nvar DELTA_V = 0.5;\nvar FLOAT_VOLTAGE = 55.2;\nvar INIT_KW = 1;\nvar INIT_DATE = \"2026-01-01\";\n\nfunction getKW(date) {\n    var d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));\n    var dayNum = d.getUTCDay() || 7;\n    d.setUTCDate(d.getUTCDate() + 4 - dayNum);\n    var yearStart = new Date(Date.UTC(d.getUTCFullYear(),0,1));\n    return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);\n}\n\nfunction hhmm(d) {\n    var h = ('0'+d.getHours()).slice(-2);\n    var m = ('0'+d.getMinutes()).slice(-2);\n    var s = ('0'+d.getSeconds()).slice(-2);\n    return h+':'+m+':'+s;\n}\n\nvar now = new Date();\nvar currentKW = getKW(now);\nvar currentDateStr = now.toISOString().slice(0,10);\nvar nowTimeStr = hhmm(now);\n\n// ----- History laden -----\nvar history = flow.get('volladung_history');\nif (!history) history = [];\n\n// Letzten Eintrag bestimmen\nvar lastFullKW = history.length > 0 ? history[history.length-1].kw : INIT_KW;\nvar lastFullDate = history.length > 0 ? history[history.length-1].date : INIT_DATE;\n\nvar lastMaxCVL = context.get('lastMaxCVL');\nvar modus = context.get('modus');\nif (!modus) modus = \"auto\";\n\n// Tracking-Zähler\nvar msgCount = context.get('msgCount') || 0;\nvar fullChargeCount = context.get('fullChargeCount') || 0;\n\n// ----- Modus Inject -----\nif (typeof msg.payload === \"string\") {\n    if ([\"manual\",\"bulk\",\"auto\"].indexOf(msg.payload) !== -1) {\n        modus = msg.payload;\n        context.set(\"modus\", modus);\n        context.set(\"lastModeChange\", nowTimeStr);\n\n        node.status({\n            fill:\"blue\",\n            shape:\"dot\",\n            text: \"⚙ \"+modus.toUpperCase()+\n                  \" | KW\"+currentKW+\n                  \" | letzte: KW\"+lastFullKW+\" (\"+lastFullDate+\")\"+\n                  \" | \"+nowTimeStr\n        });\n    }\n    return null;\n}\n\n// ----- CVL Input -----\nif (typeof msg.payload !== \"number\") return null;\nvar currentCVL = msg.payload;\nmsgCount++;\ncontext.set('msgCount', msgCount);\ncontext.set('lastCVL', currentCVL);\ncontext.set('lastUpdate', nowTimeStr);\n\nif (lastMaxCVL === undefined) lastMaxCVL = currentCVL;\n\nvar dvccVoltage;\nvar fullChargeDetected = false;\nvar deltaVal = lastMaxCVL - currentCVL;\n\n// ----- Logik -----\nif (modus === \"manual\") {\n    dvccVoltage = 0;\n}\nelse if (modus === \"bulk\") {\n    dvccVoltage = FLOAT_VOLTAGE;\n}\nelse {\n    // Volladung erkennen (Spannungsabfall)\n    if (deltaVal >= DELTA_V) {\n        if (lastFullKW !== currentKW) {\n            fullChargeDetected = true;\n            fullChargeCount++;\n            context.set('fullChargeCount', fullChargeCount);\n\n            var entry = { kw: currentKW, date: currentDateStr };\n            history.push(entry);\n            flow.set(\"volladung_history\", history);\n\n            lastFullKW = currentKW;\n            lastFullDate = currentDateStr;\n        }\n        lastMaxCVL = currentCVL;\n    }\n\n    if (currentCVL > lastMaxCVL) {\n        lastMaxCVL = currentCVL;\n    }\n\n    dvccVoltage = (lastFullKW !== currentKW) ? 0 : FLOAT_VOLTAGE;\n}\n\n// ----- Context speichern -----\ncontext.set(\"lastMaxCVL\", lastMaxCVL);\ncontext.set(\"modus\", modus);\ncontext.set(\"lastDVCC\", dvccVoltage);\n\n// ----- Statusanzeige (mehr Infos, kompakt) -----\nvar statusIcon;\nvar statusColor;\n\nif (fullChargeDetected) {\n    statusIcon = \"✓ VOLL\";\n    statusColor = \"green\";\n} else if (modus === \"manual\") {\n    statusIcon = \"⚡ MAN\";\n    statusColor = \"yellow\";\n} else if (modus === \"bulk\") {\n    statusIcon = \"≈ BULK\";\n    statusColor = \"grey\";\n} else if (dvccVoltage === 0) {\n    statusIcon = \"↑ LADE\";\n    statusColor = \"blue\";\n} else {\n    statusIcon = \"● FLOAT\";\n    statusColor = \"blue\";\n}\n\nnode.status({\n    fill: statusColor,\n    shape: \"dot\",\n    text:\n        statusIcon+\n        \" | CVL:\"+currentCVL.toFixed(2)+\"V (max:\"+lastMaxCVL.toFixed(2)+\", Δ:\"+deltaVal.toFixed(2)+\")\"+\n        \" | DVCC:\"+dvccVoltage+\"V\"+\n        \" | KW\"+currentKW+\" letzte:KW\"+lastFullKW+\" (\"+lastFullDate+\")\"+\n        \" | n=\"+msgCount+\" full=\"+fullChargeCount+\n        \" | \"+nowTimeStr\n});\n\n// ----- Output 1: DVCC -----\nvar msgDVCC = { payload: dvccVoltage };\n\n// ----- Output 2: History nur bei echter Volladung -----\nvar msgHistory = null;\n\nif (fullChargeDetected) {\n    msgHistory = {\n        payload: JSON.stringify(history, null, 2)\n    };\n}\n\nreturn [msgDVCC, msgHistory];\n",
